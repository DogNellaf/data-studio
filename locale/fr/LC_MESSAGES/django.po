msgstr "La sauvegarde a été interrompue, veuillez réessayer"

#: core/services.py:47
msgid "Taken as a full backup: the base backup is gone"
msgstr "Réalisée en complète : la sauvegarde de base n’existe plus"

#: core/services.py:48
msgid "Taken as a full backup: the base backup predates change tracking"
msgstr ""
"Réalisée en complète : la sauvegarde de base précède le suivi des "
"changements"

#: core/services.py:49
msgid "Taken as a full backup: the database schema changed"
msgstr "Réalisée en complète : le schéma de la base a changé"

#: core/services.py:56
msgid "An incremental backup needs a full backup of the same database first"
msgstr ""
"Une sauvegarde incrémentale nécessite d’abord une sauvegarde complète de la "
"même base"

#: core/services.py:59
msgid "A differential backup needs a full backup of the same database first"
msgstr ""
"Une sauvegarde différentielle nécessite d’abord une sauvegarde complète de "
"la même base"

