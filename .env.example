# Copy this file to .env and adjust the values:
#     cp .env.example .env
#
# .env is git-ignored and must never be committed.

# --- Django ---------------------------------------------------------------

# Required. Generate one with:
#     python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# In DEBUG mode a local key is generated once into .dev-secret-key when this is
# empty, so the project runs right after cloning. In production it is mandatory.
DJANGO_SECRET_KEY=

# Never enable in production: it exposes tracebacks and settings.
DJANGO_DEBUG=True

# Comma-separated. Required when DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=

# Comma-separated origins for CSRF, e.g. https://datastudio.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# DEBUG, INFO, WARNING, ERROR
DJANGO_LOG_LEVEL=INFO

# Time zone used to display backup timestamps.
DJANGO_TIME_ZONE=UTC

# --- Production hardening -------------------------------------------------
# Only take effect when DJANGO_DEBUG=False.

# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000

# Set to False when Django is exposed directly instead of sitting behind a
# reverse proxy that terminates TLS.
# DJANGO_USE_X_FORWARDED_PROTO=True

# Secure-only session/CSRF cookies. Disable only for a plain-HTTP local demo.
# DJANGO_SECURE_COOKIES=True

# --- Application database -------------------------------------------------

DATABASE_URL=postgres://postgres:postgres@localhost:5432/DataStudio

# Persistent connection lifetime, seconds (0 closes after each request).
# DB_CONN_MAX_AGE=60

# --- Backups --------------------------------------------------------------

# Directory of the local backup storage. Defaults to ./backups
# BACKUP_DIR=

# S3 or any S3-compatible storage (MinIO, ...). Setting the bucket enables it;
# run `python manage.py seed_demo` to register it in the storage catalog.
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=datastudio
# BACKUP_S3_ENDPOINT_URL=http://localhost:9000
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# path for MinIO and most self-hosted services
# BACKUP_S3_ADDRESSING_STYLE=path

# --- Backup worker ----------------------------------------------------------
# Backups are taken by `python manage.py backup_worker`.

# Encrypts the source database password while a job waits in the queue. The
# web app and every worker must share it. Defaults to a key derived from
# DJANGO_SECRET_KEY.
# BACKUP_CREDENTIALS_KEY=

# Seconds between queue checks of an idle worker.
# BACKUP_WORKER_POLL_INTERVAL=2

# Take backups inside the web request instead of queueing (no worker needed).
# BACKUP_RUN_INLINE=False

# Path to the pg_dump executable. Defaults to resolving it from PATH.
# On Windows this is usually:
#     PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
PG_DUMP_PATH=pg_dump

# Connection timeout (seconds) when reaching a remote PostgreSQL server.
DB_CONNECT_TIMEOUT=5

# Upper bound (seconds) for a single pg_dump run.
# PG_DUMP_TIMEOUT=600

# --- Demo ------------------------------------------------------------------

# Optional showcase account, created by `python manage.py seed_demo` and shown
# on the login page. Leave empty on a private deployment.
# DEMO_USERNAME=demo
# DEMO_PASSWORD=demo12345
